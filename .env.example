# Primary Node.js Web App environment variables. PHP fallback does not read these values.
# Add these in hPanel > Website Dashboard > Environment Variables.
NODE_ENV=production
# Non-negative trusted reverse-proxy hop count. Defaults to 1 only in production and 0 locally.
TRUST_PROXY_HOPS=1
SMTP_HOST=smtp.hostinger.com
# Integer from 1 through 65535. Defaults to 465 only when omitted.
SMTP_PORT=465
SMTP_USER=info@bamelenerji.com
SMTP_PASS=replace-with-the-mailbox-password
QUOTE_RECIPIENT=info@bamelenerji.com
MAIL_FROM_NAME=Bamel Enerji Web
